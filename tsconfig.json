{
	"compilerOptions": {
	  "module": "Node16",
	  "target": "ES2022",
	  "lib": ["ES2022", "DOM"],
	  "sourceMap": true,
	  "rootDir": "src",
	  "outDir": "out",
	  "strict": true,
	  "noImplicitAny": true,
	  "moduleResolution": "Node16",
	  "types": ["vscode", "node", "mocha"],
	  "forceConsistentCasingInFileNames": true
	},
	"exclude": ["node_modules", ".vscode-test", "out"]
  }
  