{
  "name": "ai-edit-manager",
  "displayName": "AI Edit Manager",
  "description": "Manage and undo AI-assisted code edits with GPT-4o, Claude, and more.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:aiEdit.configure",
    "onCommand:aiEdit.fixWithAI",
    "onCommand:aiEdit.undoLastAIEdit",
    "onCommand:aiEdit.removeToken"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiEdit.fixWithAI",
        "title": "AI Edit: Fix With AI"
      },
      {
        "command": "aiEdit.undoLastAIEdit",
        "title": "AI Edit: Undo Last AI Edit"
      },
      {
        "command": "aiEdit.configure",
        "title": "AI Edit: Configure API & Model"
      },
      {
        "command": "aiEdit.removeToken",
        "title": "AI Edit: Remove Stored API Token"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "AI Edit Manager Settings",
      "properties": {
        "aiEdit.provider": {
          "type": "string",
          "default": "openai",
          "enum": [
            "openai",
            "anthropic"
          ],
          "description": "LLM Provider (OpenAI or Anthropic)"
        },
        "aiEdit.model": {
          "type": "string",
          "default": "gpt-4o",
          "description": "Model name, e.g., gpt-4o or claude-3-sonnet-20240229"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@types/vscode": "^1.99.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.25.2",
    "eslint": "^9.9.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.5.4"
  },
  "keywords": [
    "ai",
    "openai",
    "claude",
    "refactor",
    "code assistant",
    "undo",
    "copilot alternative"
  ],
  "dependencies": {
    "ai-edit-manager": "file:"
  }
}