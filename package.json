{
  "name": "ai-edit-manager",
  "displayName": "AI Edit Manager",
  "description": "AI-powered undo and rollback manager for VS Code with Copilot and Cursor AI integration",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiEdit.settings",
        "title": "AI Edit: Configure Settings"
      },
      {
        "command": "aiEdit.undoLastAIChange",
        "title": "AI Edit: Undo Last AI Change"
      },
      {
        "command": "aiEdit.undoWithAI",
        "title": "AI Edit: Analyze and Undo with AI"
      },
      {
        "command": "aiEdit.showHistory",
        "title": "AI Edit: Show Edit History"
      },
      {
        "command": "aiEdit.rollbackToPoint",
        "title": "AI Edit: Rollback to Point"
      }
    ],
    "keybindings": [
      {
        "command": "aiEdit.undoLastAIChange",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z",
        "when": "editorTextFocus"
      },
      {
        "command": "aiEdit.undoWithAI",
        "key": "ctrl+shift+u",
        "mac": "cmd+shift+u",
        "when": "editorTextFocus"
      },
      {
        "command": "aiEdit.showHistory",
        "key": "ctrl+shift+h",
        "mac": "cmd+shift+h",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "AI Edit Manager",
      "properties": {
        "aiEdit.provider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic"
          ],
          "default": "openai",
          "description": "The AI provider to use for change analysis"
        },
        "aiEdit.apiKey": {
          "type": "string",
          "description": "API key for the selected AI provider (stored securely)"
        },
        "aiEdit.model": {
          "type": "string",
          "description": "Model to use for AI operations",
          "default": "gpt-4-turbo-preview"
        },
        "aiEdit.maxHistorySize": {
          "type": "number",
          "default": 50,
          "description": "Maximum number of history entries to keep per file"
        },
        "aiEdit.trackAIChanges": {
          "type": "boolean",
          "default": true,
          "description": "Track changes made by AI tools like GitHub Copilot and Cursor"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc -w -p ./"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.14.0",
    "@types/vscode": "^1.99.0",
    "@typescript-eslint/eslint-plugin": "^6.x",
    "@typescript-eslint/parser": "^6.x",
    "esbuild": "^0.25.2",
    "eslint": "^8.x",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "ai-edit-manager": "file:"
  }
}